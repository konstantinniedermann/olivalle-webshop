# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Brevo (E-Mail-Provider)
BREVO_API_KEY=xkeysib-...

# App
SECRET_KEY=change-me-in-production
BASE_URL=http://localhost:8000
DATABASE_PATH=olivalle.db

# IBAN für QR-Rechnung (aus NOTES.local.md)
QR_IBAN=CH...
QR_NAME=...
QR_ADDRESS=...
QR_ZIP=...
QR_CITY=...

# Admin (bcrypt-Hashes, Format: label:hash,label:hash)
# Hash generieren: python -c "import bcrypt; print(bcrypt.hashpw(b'mein-passwort', bcrypt.gensalt()).decode())"
ADMIN_CREDENTIALS=owner:$2b$12$...,dev:$2b$12$...

# Admin-Session-Lebensdauer in Sekunden (steuert die Cookie-Gueltigkeit; Default 86400 = 24h)
ADMIN_SESSION_MAX_AGE=86400

# Cookie-Sicherheit: in Produktion (HTTPS) IMMER True. Lokal/Dev auf False, falls ohne TLS getestet wird.
COOKIE_SECURE=True

# Reverse-Proxy
# In Production (fly.io) auf true lassen, damit Fly-Client-IP / X-Forwarded-For
# vertraut werden (sonst greift der BruteForceGuard nur auf die Proxy-IP).
# Lokal/in Tests auf false setzen, damit Header nicht gespooft werden können.
TRUST_PROXY_HEADERS=true
